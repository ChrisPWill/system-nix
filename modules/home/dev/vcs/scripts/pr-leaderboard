#!/usr/bin/env nu

# PR leaderboard for a squash-merge repo.
#
# This repo squash-merges, so there are no merge commits: one merged PR == one
# commit whose subject ends in "(#1234)". That suffix is what we count, so
# direct-to-main pushes (no PR number) are excluded.
#
# Author identity, window handling, and rendering live in lib/vcs.nu, shared
# with the other repo-history scripts.

const LIB = path self "lib/vcs.nu"
use $LIB *

# PRs per author for a window, keeping the merge timestamps for trend rendering.
def tally []: table -> table {
    let prs = $in
    if ($prs | is-empty) { return [] }

    $prs
    | group-by author
    | transpose author rows
    | insert prs {|r| $r.rows | length }
    | insert dates {|r| $r.rows | get date }
    | reject rows
    | rank-by prs
}

# Merged PRs in the window, one row per PR.
export def "pr list" [
    period?: string = "month"   # week | month | quarter | year
    --since (-s): string        # start of the window, e.g. "2026-07-18" — overrides period
    --until (-u): string        # end of the window; defaults to now
    --repo (-r): path = "."     # repository to inspect
    ...paths: string            # limit to these paths, e.g. `pr list month src tests`
]: nothing -> table {
    commits (window resolve $period --since $since --until $until) --repo $repo --paths $paths
    | with-pr-number
}

# Ranking table: PRs per author, most first, with dense ranks for ties, movement
# against the preceding window of the same length, and a merge-time trend.
export def main [
    period?: string = "month"   # week | month | quarter | year
    --since (-s): string        # start of the window, e.g. "2026-07-18" — overrides period
    --until (-u): string        # end of the window; defaults to now
    --repo (-r): path = "."     # repository to inspect
    ...paths: string            # limit to these paths, e.g. `pr-leaderboard month src tests`
]: nothing -> table {
    let window = (window resolve $period --since $since --until $until)
    let ranked = (commits $window --repo $repo --paths $paths | with-pr-number | tally)

    if ($ranked | is-empty) { return [] }

    let previous = (
        commits (window previous $window) --repo $repo --paths $paths
        | with-pr-number
        | tally
    )
    let peak = ($ranked | get prs | math max)

    $ranked
    | movement $previous author
    | insert trend {|r| sparkline $r.dates $window }
    | insert bar {|r| bar $r.prs $peak }
    | reject dates
    | move rank move --before author
}
