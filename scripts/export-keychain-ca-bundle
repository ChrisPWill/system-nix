#!/usr/bin/env bash
# Exports the certificates macOS trusts system-wide into one PEM bundle,
# including any root certificate that device management installed, such as
# Zscaler's. Tools from Nix don't read the macOS keychain, so on a network that
# intercepts HTTPS they need this file instead.
#
# Usage: export-keychain-ca-bundle <destination.pem>
set -euo pipefail

dest="${1:?usage: export-keychain-ca-bundle <destination.pem>}"
mkdir -p "$(dirname "$dest")"

tmp="$(mktemp "${dest}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

/usr/bin/security find-certificate -a -p \
  /System/Library/Keychains/SystemRootCertificates.keychain \
  /Library/Keychains/System.keychain >"$tmp"

# An empty bundle would make every HTTPS connection fail, so keep the old one.
if [[ ! -s "$tmp" ]]; then
  echo "export-keychain-ca-bundle: no certificates found; leaving $dest unchanged" >&2
  exit 1
fi

chmod 0644 "$tmp"
mv "$tmp" "$dest"
trap - EXIT
